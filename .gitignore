# =============================================================================
# .gitignore — SECURITY-FIRST / PUBLIC REPOSITORY READY
# =============================================================================
# Objectif :
# - empêcher le commit accidentel de secrets et données locales
# - exclure les dépendances, builds, caches, logs et fichiers temporaires
# - préparer un dépôt destiné à pouvoir devenir PUBLIC
#
# IMPORTANT :
# .gitignore ne protège PAS les fichiers déjà présents dans l'historique Git.
# =============================================================================


# =============================================================================
# 1. SECRETS / ENVIRONMENT / CREDENTIALS
# =============================================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.env
*.env.local
*.local.env

secrets/
secret/
.secrets/
private/
.private/

credentials/
.credentials/

credentials.json
credentials.yml
credentials.yaml

secrets.json
secrets.yml
secrets.yaml

auth.json
auth.local.json

config.local
config.local.*
*.local.config
*.local.json
*.local.yml
*.local.yaml

# Tokens / credentials
*.token
*.tokens
*.secret
*.secrets
*.credentials

